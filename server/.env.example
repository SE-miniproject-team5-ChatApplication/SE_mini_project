# Copy this file to server/.env and fill in real values.
# NEVER commit server/.env (it is in .gitignore) - NFR-SEC-2.
NODE_ENV=development
PORT=5000
MONGO_URL=mongodb://127.0.0.1:27017/chatapp
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# bcrypt cost factor, never below 10
BCRYPT_ROUNDS=10

# Folder for uploaded files, outside any public web folder
UPLOAD_DIR=./uploads
